# Copiado para /srv/achoupromo/.env pelo instalar.sh (que gera a SECRET_KEY sozinho).
# Depois de mudar este arquivo no servidor: sudo systemctl restart achoupromo

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria
DJANGO_ALLOWED_HOSTS=achoupromo.com.br,www.achoupromo.com.br,IP_DO_SERVIDOR
DJANGO_CSRF_TRUSTED_ORIGINS=https://achoupromo.com.br,https://www.achoupromo.com.br
# Mude para 1 depois de rodar o https.sh (certificado instalado)
DJANGO_HTTPS=0

DJANGO_DB_PATH=/srv/achoupromo/dados/db.sqlite3
DJANGO_MEDIA_ROOT=/srv/achoupromo/media
DJANGO_STATIC_ROOT=/srv/achoupromo/static

SITE_URL=https://achoupromo.com.br
