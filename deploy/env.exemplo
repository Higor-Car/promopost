# Copiado para /srv/achoupromo/.env pelo instalar.sh, que preenche __DOMINIO__, __IP__ e a chave.
# Para trocar o domínio depois, use deploy/trocar-dominio.sh (não edite à mão).
# Depois de mudar este arquivo no servidor: sudo systemctl restart achoupromo

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria
DJANGO_ALLOWED_HOSTS=__DOMINIO__,www.__DOMINIO__,__IP__
DJANGO_CSRF_TRUSTED_ORIGINS=https://__DOMINIO__,https://www.__DOMINIO__
# Fica 1 depois de rodar o https.sh (certificado instalado)
DJANGO_HTTPS=0

DJANGO_DB_PATH=/srv/achoupromo/dados/db.sqlite3
DJANGO_MEDIA_ROOT=/srv/achoupromo/media
DJANGO_STATIC_ROOT=/srv/achoupromo/static

SITE_URL=https://__DOMINIO__
