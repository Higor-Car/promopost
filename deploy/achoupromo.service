[Unit]
Description=Achou Promo (gunicorn)
After=network.target

[Service]
Type=simple
User=achoupromo
Group=www-data
RuntimeDirectory=achoupromo
WorkingDirectory=/srv/achoupromo/app
EnvironmentFile=/srv/achoupromo/.env
ExecStart=/srv/achoupromo/venv/bin/gunicorn config.wsgi:application \
    --bind unix:/run/achoupromo/gunicorn.sock \
    --umask 007 \
    --workers 2 \
    --timeout 30 \
    --access-logfile - \
    --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
